export function {{ componentName }}() {
  return (
    <section className="bg-white py-20 sm:py-24 lg:py-32">
      <div className="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div className="mx-auto max-w-4xl text-center mb-16">
          <h2 className="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{{ title }}</h2>
          {% if description %}
            <p className="mt-6 text-lg leading-8 text-slate-600">{{ description }}</p>
          {% endif %}
        </div>

        {% if plans %}
          <div className="isolate mx-auto grid max-w-md grid-cols-1 gap-8 lg:max-w-none lg:grid-cols-3">
            {% for plan in plans %}
              <div className="rounded-3xl p-8 xl:p-10 {% if plan.highlighted %}ring-2 ring-indigo-600 bg-slate-50 relative{% else %}ring-1 ring-slate-200 bg-white{% endif %}">
                {% if plan.highlighted %}
                  <p className="absolute -top-4 right-8 rounded-full bg-indigo-600 px-3 py-1 text-xs font-semibold text-white shadow-sm ring-1 ring-inset ring-indigo-600">Popular</p>
                {% endif %}
                <div className="flex items-center justify-between gap-x-4">
                  <h3 className="text-lg font-semibold leading-8 {% if plan.highlighted %}text-indigo-600{% else %}text-slate-900{% endif %}">{{ plan.name }}</h3>
                </div>
                <p className="mt-4 text-sm leading-6 text-slate-600">{{ plan.description }}</p>
                <p className="mt-6 flex items-baseline gap-x-1">
                  <span className="text-4xl font-bold tracking-tight text-slate-900">{{ plan.price }}</span>
                  {% if plan.billingPeriod %}<span className="text-sm font-semibold leading-6 text-slate-600">{{ plan.billingPeriod }}</span>{% endif %}
                </p>
                {% if plan.button %}
                  <a href="{{ plan.button.href }}" className="mt-6 block rounded-md py-2 px-3 text-center text-sm font-semibold leading-6 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 transition-colors
                    {% if plan.highlighted %}bg-indigo-600 text-white hover:bg-indigo-500 focus-visible:outline-indigo-600 shadow-sm
                    {% else %}bg-indigo-50 text-indigo-600 hover:bg-indigo-100{% endif %}">
                    {{ plan.button.text }}
                  </a>
                {% endif %}
                
                {% if plan.features %}
                  <ul role="list" className="mt-8 space-y-3 text-sm leading-6 text-slate-600">
                    {% for feature in plan.features %}
                      <li className="flex gap-x-3">
                        <svg className="h-6 w-5 flex-none text-indigo-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                          <path fillRule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clipRule="evenodd" />
                        </svg>
                        {{ feature }}
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </section>
  );
}
