export function {{ componentName }}() {
  return (
    <footer className="bg-slate-900 py-12 sm:py-16">
      <div className="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div className="xl:grid xl:grid-cols-3 xl:gap-8">
          <div className="space-y-8 xl:col-span-1">
            <span className="text-2xl font-bold text-white">{{ name }}</span>
            {% if tagline %}
              <p className="text-sm leading-6 text-slate-400">
                {{ tagline }}
              </p>
            {% endif %}
            {% if socialLinks %}
              <div className="flex space-x-6">
                {% for social in socialLinks %}
                  <a href="{{ social.url }}" className="text-slate-500 hover:text-slate-400">
                    <span className="sr-only">{{ social.label | default(social.platform) }}</span>
                    {/* Fallback to text if icon is not provided */}
                    <span className="text-sm font-medium">{{ social.platform }}</span>
                  </a>
                {% endfor %}
              </div>
            {% endif %}
          </div>
          
          {% if linkGroups %}
            <div className="mt-16 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0">
              {% for group in linkGroups %}
                <div className="md:grid md:grid-cols-1 md:gap-8">
                  <div>
                    <h3 className="text-sm font-semibold leading-6 text-white">{{ group.heading }}</h3>
                    <ul role="list" className="mt-6 space-y-4">
                      {% for link in group.links %}
                        <li>
                          <a href="{{ link.href }}" className="text-sm leading-6 text-slate-400 hover:text-white">
                            {{ link.label }}
                          </a>
                        </li>
                      {% endfor %}
                    </ul>
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
        
        <div className="mt-16 border-t border-slate-800 pt-8 sm:mt-20 lg:mt-24">
          <p className="text-sm leading-5 text-slate-400">
            &copy; {{ copyright | default(name + " All rights reserved.") }}
          </p>
        </div>
      </div>
    </footer>
  );
}
