export function Footer() {
  return (
    <footer className="bg-slate-900">
      <div className="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">

        <div className="xl:grid xl:grid-cols-3 xl:gap-8">

          {/* Brand */}
          <div className="space-y-4">
            <h3 className="text-lg font-bold text-white">
              {{ name }}
            </h3>

            {% if tagline %}
            <p className="max-w-xs text-sm leading-6 text-slate-400">
              {{ tagline }}
            </p>
            {% endif %}
          </div>

          {/* Link Groups */}
          {% if linkGroups and linkGroups.length %}
          <div className="mt-12 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0">

            {% for group in linkGroups %}
            <div>
              <h4 className="text-sm font-semibold leading-6 text-white">
                {{ group.heading }}
              </h4>
              <ul className="mt-4 space-y-3">
                {% for link in group.links %}
                <li>
                  <a
                    href="{{ link.href }}"
                    className="text-sm leading-6 text-slate-400 transition-colors hover:text-white"
                  >
                    {{ link.text }}
                  </a>
                </li>
                {% endfor %}
              </ul>
            </div>
            {% endfor %}

          </div>
          {% endif %}

        </div>

        {/* Copyright */}
        {% if copyright %}
        <div className="mt-12 border-t border-slate-800 pt-8">
          <p className="text-center text-sm leading-5 text-slate-500">
            {{ copyright }}
          </p>
