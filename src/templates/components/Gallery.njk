export function {{ componentName }}() {
  return (
    <section className="bg-slate-50 py-24 sm:py-32">
      <div className="mx-auto max-w-7xl px-6 lg:px-8">
        <div className="mx-auto max-w-2xl text-center mb-16">
          <h2 className="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{{ title }}</h2>
          {% if description %}
            <p className="mt-6 text-lg leading-8 text-slate-600">{{ description }}</p>
          {% endif %}
        </div>

        {% if items %}
          <div className="columns-1 gap-6 sm:columns-2 lg:columns-3 space-y-6">
            {% for item in items %}
              <div className="group relative break-inside-avoid rounded-2xl overflow-hidden bg-slate-100 ring-1 ring-slate-200">
                <img src="{{ item.src }}" alt="{{ item.alt | default(item.title) }}" className="w-full object-cover group-hover:scale-105 transition-transform duration-500" />
                {% if item.title or item.description %}
                  <div className="absolute inset-0 bg-gradient-to-t from-slate-900/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
                    {% if item.title %}
                      <h3 className="text-lg font-semibold text-white">{{ item.title }}</h3>
                    {% endif %}
                    {% if item.description %}
                      <p className="mt-2 text-sm text-slate-300">{{ item.description }}</p>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </section>
  );
}
