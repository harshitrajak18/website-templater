export function {{ componentName }}() {
  return (
    <section className="bg-white py-16">
      <div className="mx-auto max-w-7xl px-6 lg:px-8 text-center">
        {% if title %}
          <h2 className="text-lg font-semibold leading-8 text-slate-900 mb-8">{{ title }}</h2>
        {% endif %}
        
        {% if items %}
          <div className="flex justify-center gap-x-6 sm:gap-x-10">
            {% for item in items %}
              <a href="{{ item.url }}" className="text-slate-400 hover:text-indigo-600 transition-colors duration-300 flex flex-col items-center gap-2">
                <span className="sr-only">{{ item.label | default(item.platform) }}</span>
                {/* Fallback to text for platforms */}
                <div className="flex h-12 w-12 items-center justify-center rounded-full bg-slate-50 ring-1 ring-slate-200 group-hover:ring-indigo-600">
                  <span className="font-semibold text-sm">{{ item.platform | first }}</span>
                </div>
                <span className="text-xs font-medium text-slate-600">{{ item.platform }}</span>
              </a>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </section>
  );
}
