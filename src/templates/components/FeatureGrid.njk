export function {{ componentName }}() {
  return (
    <section className="bg-white py-20 sm:py-24 lg:py-32">
      <div className="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div className="mx-auto max-w-2xl lg:text-center">
          <h2 className="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{{ title }}</h2>
          {% if description %}
            <p className="mt-6 text-lg leading-8 text-slate-600">{{ description }}</p>
          {% endif %}
        </div>
        
        {% if items %}
          <div className="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
            <div className="grid grid-cols-1 gap-x-8 gap-y-10 md:grid-cols-2 
              {% if columns == 2 %}lg:grid-cols-2{% elif columns == 4 %}lg:grid-cols-4{% else %}lg:grid-cols-3{% endif %}">
              {% for item in items %}
                <div className="relative">
                  <dt>
                    {% if item.icon %}
                      <div className="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-600 text-white text-xl">
                        {{ item.icon }}
                      </div>
                    {% endif %}
                    <p className="{% if item.icon %}ml-16{% endif %} text-lg font-semibold leading-8 text-slate-900">{{ item.title }}</p>
                  </dt>
                  <dd className="{% if item.icon %}ml-16{% endif %} mt-2 text-base leading-7 text-slate-600">{{ item.description }}</dd>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </div>
    </section>
  );
}
