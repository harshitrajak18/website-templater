export function {{ componentName }}() {
  return (
    <section className="bg-indigo-50 py-24 sm:py-32">
      <div className="mx-auto max-w-7xl px-6 lg:px-8">
        <div className="mx-auto max-w-2xl lg:text-center mb-16">
          <h2 className="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{{ title }}</h2>
          {% if description %}
            <p className="mt-6 text-lg leading-8 text-slate-600">{{ description }}</p>
          {% endif %}
        </div>

        {% if items %}
          <div className="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
            <dl className="grid max-w-xl grid-cols-1 gap-x-8 gap-y-12 lg:max-w-none lg:grid-cols-3 md:grid-cols-2">
              {% for item in items %}
                <div className="flex flex-col bg-white rounded-3xl px-8 py-10 shadow-sm ring-1 ring-slate-200 hover:shadow-lg transition-shadow duration-300">
                  <dt className="flex items-center gap-x-3 text-xl font-semibold leading-7 text-slate-900">
                    {% if item.icon %}
                      <div className="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-600 text-white text-2xl">
                        {{ item.icon }}
                      </div>
                    {% endif %}
                    <span className="ml-2">{{ item.title }}</span>
                  </dt>
                  <dd className="mt-6 flex flex-auto flex-col text-base leading-7 text-slate-600">
                    <p className="flex-auto">{{ item.description }}</p>
                  </dd>
                </div>
              {% endfor %}
            </dl>
          </div>
        {% endif %}
      </div>
    </section>
  );
}
