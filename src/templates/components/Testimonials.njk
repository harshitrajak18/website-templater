export function {{ componentName }}() {
  return (
    <section className="bg-slate-50 py-20 sm:py-24 lg:py-32">
      <div className="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div className="mx-auto max-w-2xl text-center mb-16">
          <h2 className="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{{ title }}</h2>
          {% if description %}
            <p className="mt-6 text-lg leading-8 text-slate-600">{{ description }}</p>
          {% endif %}
        </div>

        {% if items %}
          <div className="mx-auto grid max-w-2xl grid-cols-1 gap-8 lg:mx-0 lg:max-w-none lg:grid-cols-3">
            {% for item in items %}
              <div className="flex flex-col justify-between rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
                <blockquote className="text-lg leading-8 text-slate-900">
                  <p>&ldquo;{{ item.quote }}&rdquo;</p>
                </blockquote>
                <div className="mt-6 flex items-center gap-x-4">
                  {% if item.avatar %}
                    <img className="h-12 w-12 rounded-full bg-slate-50 object-cover" src="{{ item.avatar }}" alt="{{ item.name }}" />
                  {% else %}
                    <div className="flex h-12 w-12 items-center justify-center rounded-full bg-indigo-100 text-lg font-bold text-indigo-600">
                      {{ item.name | first }}
                    </div>
                  {% endif %}
                  <div>
                    <div className="font-semibold text-slate-900">{{ item.name }}</div>
                    <div className="text-sm leading-6 text-slate-600">{{ item.role }}{% if item.company %} at {{ item.company }}{% endif %}</div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </section>
  );
}
